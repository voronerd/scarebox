# Copy to .env (chmod 600). Never commit .env.
# Camera (Dahua/Amcrest-style RTSP + CGI, digest auth)
CAMERA_HOST=192.0.2.10
# The camera's login user (its manual gives the factory default).
CAMERA_USER=change-me
CAMERA_PASSWORD=change-me
# Token for the aim page (:8090). Any long random string.
AIM_TOKEN=change-me
